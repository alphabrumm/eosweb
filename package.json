{
  "name": "weos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EOS – Einfache objektorientierte Sprache, als Web-App für iPad und Browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build-single": "vite build --config vite.config-single.ts && node scripts/inline.mjs",
    "test": "esbuild tests/run-examples.ts --bundle --platform=node --format=esm --outfile=dist-test/run.mjs && node dist-test/run.mjs examples 20000"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "typescript": "^5.9.3",
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0"
  }
}