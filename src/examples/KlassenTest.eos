// EOS 1.5 - Programm
r:RECHTECK
f:FENSTER
k:KREIS
e:ELLIPSE
s:LINIE

f.zeichne(r)
f.NameSetzen('Test')
f.NameSetzen(f.name + ' nochmal')

r.EckenSetzen(-20,20,30,-40)

r.FüllfarbeSetzen (gelb)
r.FüllartSetzen(schraffiert)

r.RandstärkeSetzen(2)
r.RandartSetzen(gestrichelt)
r.RandstärkeSetzen(1)  // Jetzt erst tritt die Linienart zu Tage!
r.RandfarbeSetzen(blau)

r.verschieben(-20,20)
// jetzt kommt der Kreis
f.zeichne(k)
k.radiusSetzen(30)
k.verschieben(20,20)
f.zeichne(e)

e.radiusxSetzen(20)
e.radiusySetzen(40)
e.MittelpunktSetzen(50,-100)

f.zeichne(s)
s.EndPunkteSetzen(-30,-40,30,40)

s.FarbeSetzen(blau)
s.LinienStärkeSetzen(5)

t: textfeld
f.zeichne(t)
t.verschieben(-70,-50)
t.zeileHinzufügen('Textfeld')
t.SchriftgrößeSetzen(8)

g: Gruppe
g.kopiere(r) g.kopiere(k) g.kopiere(e) g.kopiere(s)
f.zeichne(g)
wiederhole immer
   wiederhole 50 mal
      g.verschieben(1,1)
   *wiederhole
   wiederhole 50 mal
      g.verschieben(-1,-1)
   *wiederhole
*wiederhole

