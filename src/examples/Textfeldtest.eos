t.AusrichtungvertikalSetzen(untenbündig)

t.DurchsichtigSetzen(wahr)

wiederhole immer
   wiederhole 100 mal
      t.verschieben(-1,1)
   *wiederhole
   wiederhole 100 mal
      t.verschieben(1,-1)
   *wiederhole
*wiederhole
